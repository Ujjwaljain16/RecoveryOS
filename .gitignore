# RecoveryOS — .gitignore
# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
.eggs/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ─── Secrets — never commit ────────────────────────────────────────────────────
.env
.env.local
.env*.local
*.pem
*.key
secrets/

# ─── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
apps/dashboard/.next/
apps/dashboard/node_modules/
apps/dashboard/tsconfig.tsbuildinfo

# ─── Docker ────────────────────────────────────────────────────────────────────
.docker/

# ─── Alembic ───────────────────────────────────────────────────────────────────
# Keep migrations/versions/ — never gitignore those
migrations/__pycache__/

# ─── Models / data ─────────────────────────────────────────────────────────────
# Intermediate/baseline training pickles (e.g. model_mlp.pkl) are ignored by
# default, but services/recovery_engine/propensity.py hard-loads model_lr.pkl
# + feature_transformer_v1.pkl at runtime -- a blanket models/**/*.pkl rule
# silently omitted those two from every clone, while model_lightgbm.txt (a
# .txt, dodging the glob) shipped despite being the deprecated model
# (gaps.md §C.2). Fixed in Task MD1, pre-Phase-8 audit.
models/**/*.pkl
!models/recovery/artifacts/model_lr.pkl
!models/recovery/artifacts/feature_transformer_v1.pkl
models/**/*.joblib
models/**/*.bin
*.csv
*.parquet
# Phase 8 evaluation's raw export -- deliberately tracked so the headline
# number is re-derivable from a flat file, not just trusted from a
# dashboard (tests/evaluation/report.md's whole point).
!tests/evaluation/artifacts/phase8_payment_outcomes.csv
!tests/evaluation/artifacts/phase8_payment_outcomes.parquet

# ─── Local scratch backups ──────────────────────────────────────────────────────
# One-off local safety-net copy of data/ made before regenerating the
# Phase-2 dataset (the seed-decorrelation/calibration fix) -- never meant
# to be committed, just a personal rollback point.
data_pre_step3_backup/

# ─── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
