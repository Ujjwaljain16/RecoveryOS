# RecoveryOS — Environment Configuration Template
# Copy this to .env and fill in secrets. Never commit .env.

# ─── Environment ──────────────────────────────────────────────────────────────
# Options: demo | staging | test
ENV=demo

# ─── Database roles (Task 6) ───────────────────────────────────────────────────
# Read by migrations/versions/0002_db_roles.py at `alembic upgrade` time to set
# the recoveryos/diagnoser DB users' passwords — NOT hardcoded in the migration
# file. Generate real random values, e.g.: python -c "import secrets; print(secrets.token_urlsafe(24))"
# These values are compromised the moment they're committed anywhere, including
# here — leave this file's values blank/placeholder, only .env (gitignored)
# should ever hold the real ones.
RECOVERYOS_APP_ROLE_PASSWORD=<CHANGE_ME>
RECOVERYOS_DIAGNOSER_ROLE_PASSWORD=<CHANGE_ME>
RECOVERYOS_INFERENCE_ROLE_PASSWORD=<CHANGE_ME>

# Grafana admin login (docker-compose.yml's grafana service) — was also a
# hardcoded literal ('recoveryos'), found in the same Task 6 grep sweep.
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME>

# ─── Database ─────────────────────────────────────────────────────────────────
# The password in each URL below MUST match the corresponding
# RECOVERYOS_*_PASSWORD var above — the migration sets the role's actual
# password from those vars; these connection strings are what the
# application/Alembic use to connect with it. Keeping them in sync is a
# manual operator step today (see .env.example for both is intentional: it's
# how you notice if they've drifted).
# NOTE: the diagnoser LOGIN user is named "diagnoser" (diagnoser_role is a
# NOLOGIN role granted to it, not itself a connectable username).
DATABASE_URL=postgresql+asyncpg://recoveryos:<CHANGE_ME>@postgres:5432/recoveryos
DATABASE_URL_SYNC=postgresql://recoveryos:<CHANGE_ME>@postgres:5432/recoveryos
DIAGNOSER_DATABASE_URL=postgresql+asyncpg://diagnoser:<CHANGE_ME>@postgres:5432/recoveryos
INFERENCE_DATABASE_URL=postgresql+asyncpg://inference:<CHANGE_ME>@postgres:5432/recoveryos

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth (Task 4) ──────────────────────────────────────────────────────────────
# Server-side secret mixed into merchants.api_key_hash (HMAC-SHA256). Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_PEPPER=<CHANGE_ME>

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# gemini is the only LLM provider diagnose_with_llm()/the investigator
# support. Any other ai_diagnoser_provider value skips the LLM path
# entirely and falls back to the deterministic diagnoser.
AI_DIAGNOSER_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_DIAGNOSER_GEMINI_MODEL=gemini-2.5-flash-lite

# Gate for the bounded AI tie-break/risk-escalation fusion step
# (services/recovery_engine/orchestrator.py::_apply_ai_fusion, docs/TRD.md
# §3.5) -- separate from AI_DIAGNOSER_PROVIDER above: that gates whether
# the investigator's diagnosis is LLM-produced at all; this gates whether
# that diagnosis's RecoveryRecommendation is additionally allowed to
# influence chosen_action (only via an economic near-tie already
# independently policy-ALLOWED, or a closed-set risk_flags signal forcing
# ESCALATE -- see AIRiskSignalEscalationRule, never a direct grant of
# authority). Defaults to false ("ships dark") so a fresh checkout is
# byte-identical to the pre-fusion decision pipeline until set explicitly.
# The demo scenarios in README's "run the demo" section (POST
# /v1/simulate/scenario) 409 with a clear message if this is false --
# set it true here before running them, not just in a shell one-off.
AI_RECOMMENDATION_FUSION_ENABLED=false

# ─── Payment provider (Phase 6) ────────────────────────────────────────────────
# 'simulator' | 'razorpay_test' — one-line swap, see integrations/razorpay/adapter.py
PAYMENT_PROVIDER_ADAPTER=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ─── Razorpay webhooks (Task WEBHOOK1) ─────────────────────────────────────────
# Separate secret from RAZORPAY_KEY_SECRET above -- generated in the Razorpay
# dashboard specifically for signing webhook payloads (Settings > Webhooks).
# Required for POST /webhooks/razorpay to accept anything (missing/empty
# secret = every webhook rejected, fail-closed).
RAZORPAY_WEBHOOK_SECRET=
