# RecoveryOS — Environment Configuration Template
# Copy this to .env and fill in secrets. Never commit .env.

# ─── Environment ──────────────────────────────────────────────────────────────
# Options: demo | staging | test
ENV=demo

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://recoveryos:recoveryos@postgres:5432/recoveryos
DATABASE_URL_SYNC=postgresql://recoveryos:recoveryos@postgres:5432/recoveryos
DIAGNOSER_DATABASE_URL=postgresql+asyncpg://diagnoser_role:diagnoser_pass@postgres:5432/recoveryos

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_api_key_here
AI_DIAGNOSER_TIMEOUT_SECONDS=2.5
AI_DIAGNOSER_MODEL=gpt-4o-mini
